{
  "name": "falcon",
  "version": "1.0.0",
  "private": true,
  "description": "Terminal-first WhatsApp sender using whatsapp-web.js",
  "scripts": {
    "send": "tsx send.ts",
    "deploy": "bash deploy.sh",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run check && bash -n deploy.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
