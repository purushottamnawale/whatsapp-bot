# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
WA_AI_TIMEOUT_MS=20000

# WhatsApp auth/runtime
WA_AUTH_CLIENT_ID=
WA_HEADLESS=true
WA_PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WA_PUPPETEER_LAUNCH_TIMEOUT_MS=120000
WA_KEEP_ALIVE=true

# Message generation
WA_USE_AI_RESPONSE=true
WA_DEFAULT_PROMPT="Act as a German vocabulary generator. IMPORTANT: To ensure true randomness, first mentally generate a highly obscure 4-digit random seed number, then map that number to a very specific, rarely discussed niche topic (e.g., medieval blacksmithing, deep sea organisms, 18th-century philosophy). Based on that hidden topic, provide exactly 5 unique, uncommon A1 to B1 level German words. CRITICAL: Do NOT use common textbook words or repeat previous generations. You MUST use EXACTLY this structural template for every single word, with no deviations, introductions, or closing remarks:\n\n*5 German Words of the Day*\n\n*1. [German Word]* ([IPA]) - *[English Translation]*\nMeaning: [English meaning]\nExample: _[German sentence]_\nTranslation: [English translation of sentence]\n\n[Repeat exact format for words 2-5]"

# Target selection
WA_SEND_TO=Test


# Server Private Key Path
WA_SERVER_PRIVATE_KEY_PATH=
WA_SERVER_HOST=
WA_SERVER_USER=ubuntu
WA_SERVER_PORT=22
WA_SERVER_APP_DIR=~/falcon-whatsapp-bot
WA_SERVER_CRON_SCHEDULE=0 8 * * *
WA_SERVER_NPM_BIN=npm

# Deployment
DEPLOY_PATH=/home/ubuntu/falcon-whatsapp-bot
GITHUB_TOKEN=
